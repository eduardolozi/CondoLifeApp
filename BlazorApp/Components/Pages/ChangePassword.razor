@page "/mudar-senha"
@layout Layout.EmptyLayout
@inject UserService UserService
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject PageHelper PageHelper
@inject IDialogService DialogService

<PageTitle>Mudança de senha</PageTitle>

<MudContainer Class="w-100 d-flex flex-column align-items-center mt-15">
    <MudPaper Elevation="1" Class="d-flex flex-column align-items-center justify-content-around w-50 px-5">
        <MudText Style="text-align: center" Class="mt-5 mb-3 fw-bold" Typo="Typo.h5">Antes de prosseguir, mude a senha para garantir a sua segurança!</MudText>
        <MudTextField Class="w-75 mt-7 mb-3"
                      @bind-Value="_password"
                      Variant="Variant.Outlined"
                      Error="_passwordHasError"
                      ErrorText="@_passwordErrorMessage"
                      Placeholder="Insira a nova senha"
                      InputType="@_passwordInputType"
                      Adornment="Adornment.End"
                      AdornmentColor="Color.Success"
                      AdornmentIcon="@_passwordInputIcon"
                      OnAdornmentClick="(() => this.ChangePasswordVisibility())">
        </MudTextField>
        <MudButton Class="mb-7 w-75"
                   Style="background-color: #019863; color: white"
                   ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Size="Size.Large"
                   OnClick="SubmitChangePassword">
            Alterar senha
        </MudButton>
        @if (_isLoading)
        {
            <div class="w-75 mt-5 d-flex flex-row justify-content-center align-items-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    string _password;
    User? _user = new();
    InputType _passwordInputType = InputType.Password;
    string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    bool _isPasswordVisible;
    bool _isLoading = false;
    bool _passwordHasError;
    string _passwordErrorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _user = await AuthService.GetUserByClaims();

            }
            catch (Exception e)
            {
                await DialogService.ShowMessageBox("Erro!", e.Message);
            }
        }
    }

    private void ChangePasswordVisibility() {
        if (_isPasswordVisible) {
            _isPasswordVisible = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
            return;
        }

        _isPasswordVisible = true;
        _passwordInputIcon = Icons.Material.Filled.Visibility;
        _passwordInputType = InputType.Text;
    }

    async Task SubmitChangePassword()
    {
        try
        {
            var invalidPassword = ValidatePassword();
            if(invalidPassword) return;

            _isLoading = true;
            StateHasChanged();
            await PageHelper.ShowBusy(ref _isLoading, async () =>
            {
                await UserService.ChangeTemporaryPassword((int) _user!.Id!, _password);
            });
            StateHasChanged();
            await DialogService.ShowMessageBox("Sucesso!", "Sua senha foi alterada. A partir de agora, utilize ela nos próximos acessos!");
            Navigation.NavigateTo("feed");
        }
        catch (Exception e)
        {
            await DialogService.ShowMessageBox("Erro!", e.Message);
        }
    }

    bool ValidatePassword()
    {
        if (string.IsNullOrEmpty(_password))
        {
            _passwordHasError = true;
            _passwordErrorMessage = "A senha deve ser informada.\n";
        }
        else if (_password.Length < 8)
        {
            _passwordHasError = true;
            _passwordErrorMessage = "A senha deve ter mais de 8 caracteres.\n";
        }
        else _passwordHasError = false;

        return _passwordHasError;
    }
}